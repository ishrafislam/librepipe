<?xml version="1.0" encoding="utf-8"?>
<!-- Blank splash icon: makes the Android 12 system splash a bare surface frame
     (no forced large icon) so it hands off seamlessly into the Compose splash. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1dp"
    android:height="1dp"
    android:viewportWidth="1"
    android:viewportHeight="1" />
